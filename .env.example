# Farfurie env (optional)

# Vision for plate-from-photo and cookbook OCR (Gemini preferred).
# When unset, the UI shows a local heuristic and hides cookbook photo import.
# GET /api/vision returns { "vision": true|false } — never the key.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Override where account/sync JSON is stored
# FARFURIE_DATA_DIR=./data
